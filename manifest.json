{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "BrowserAway",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "{6f1c3b0e-4d7a-4c58-9a52-1e8b7d0f93a4}",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["notifications", "tabs", "storage", "tabGroups", "menus", "idle"],
  "optional_permissions": ["browsingData"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "__MSG_extName__"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "commands": {
    "lock_browser_now_fixed": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "__MSG_commandLockNow__"
    }
  }
}
